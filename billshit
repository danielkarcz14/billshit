#!/usr/bin/env python3
"""Run from a checkout, including through a symlink in PATH."""
import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("billshit requires Python 3.11 or newer")

root = Path(__file__).resolve().parent
sys.path.insert(0, str(root / "src"))
from billshit.cli import main

raise SystemExit(main(root=root))
